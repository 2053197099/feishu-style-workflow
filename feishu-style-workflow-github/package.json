{
  "name": "feishu-style-workflow",
  "version": "1.0.0",
  "private": true,
  "description": "API-first Feishu Bitable image transfer workflow for style seed form submissions.",
  "scripts": {
    "check": "node --check feishu_style_workflow.js",
    "prepare:rows": "node feishu_style_workflow.js prepare",
    "submit:rows": "node feishu_style_workflow.js submit",
    "verify:seeds": "node feishu_style_workflow.js verify",
    "cleanup:rows": "node feishu_style_workflow.js cleanup"
  },
  "dependencies": {
    "playwright-core": "^1.60.0"
  }
}
